{
  "name": "moviepalace",
  "version": "1.0.0",
  "description": "",
  "main": "dist/moviepalace-server.js",
  "scripts": {
    "clean": "rm -rf dist",
    "copy-static": "node -e \"require('fs').cpSync('src/blurred-poster', 'dist/blurred-poster', {recursive:true})\"",
    "build": "npm run clean && tsc && npm run copy-static",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:populate": "ts-node src/scripts/populate-movies.ts",
    "db:sync-movies": "ts-node src/scripts/sync-movies.ts",
    "db:sync-keywords": "ts-node src/scripts/sync-keywords.ts",
    "db:sync-actors": "ts-node src/scripts/sync-actors.ts",
    "db:migrate-cast-links-actors": "ts-node src/scripts/migrate-cast-links-actors.ts",
    "db:populate-keywords": "ts-node src/scripts/populate-keywords.ts",
    "db:add-movie": "ts-node src/scripts/add-movie.ts",
    "db:sort-movie-keywords": "ts-node src/scripts/sort-movie-keywords.ts",
    "db:seed-cast-links": "ts-node src/scripts/seed-cast-links.ts",
    "db:sync-all": "npm run db:sync-movies && npm run db:sync-keywords && npm run db:sync-actors && npm run db:sort-movie-keywords",
    "db:populate-popular": "ts-node src/scripts/populate-popular.ts",
    "db:populate-genre": "ts-node src/scripts/populate-genre.ts",
    "db:export-questions": "ts-node src/scripts/export-questions.ts",
    "db:import-questions": "ts-node src/scripts/import-questions.ts",
    "db:add-genres": "ts-node src/scripts/add-genres.ts",
    "db:create-tables": "ts-node src/scripts/create-tables.ts",
    "db:init": "npm run db:generate && npm run db:create-tables && npm run db:seed-cast-links && npm run db:populate-popular && npm run db:sync-all",
    "cleanWin": "if exist dist rmdir /s /q dist",
    "buildWin": "npm run cleanWin && tsc && npm run copy-static",
    "pack": "powershell -ExecutionPolicy Bypass -File pack-prod.ps1",
    "start": "node dist/moviepalace-server.js",
    "dev": "ts-node src/moviepalace-server.ts",
    "dev:web": "ts-node src/webServer.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/node-fetch": "^2.6.13",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
