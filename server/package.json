{
  "name": "moviepalace",
  "version": "1.0.0",
  "description": "",
  "main": "dist/moviepalace-server.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:populate": "ts-node src/scripts/populate-movies.ts",
    "db:sync-movies": "ts-node src/scripts/sync-movies.ts",
    "db:sync-keywords": "ts-node src/scripts/sync-keywords.ts",
    "db:sync-actors": "ts-node src/scripts/sync-actors.ts",
    "db:migrate-cast-links-actors": "ts-node src/scripts/migrate-cast-links-actors.ts",
    "db:populate-keywords": "ts-node src/scripts/populate-keywords.ts",
    "db:add-movie": "ts-node src/scripts/add-movie.ts",
    "db:sort-movie-keywords": "ts-node src/scripts/sort-movie-keywords.ts",
    "db:seed-cast-links": "ts-node src/scripts/seed-cast-links.ts",
    "db:sync-all": "npm run db:sync-movies && npm run db:populate-popular && npm run db:sync-keywords && npm run db:sync-actors && npm run db:populate-keywords && npm run db:sort-movie-keywords && npm run db:migrate-cast-links-actors",
    "db:populate-popular": "ts-node src/scripts/populate-popular.ts",
    "db:export-questions": "ts-node src/scripts/export-questions.ts",
    "db:import-questions": "ts-node src/scripts/import-questions.ts",
    "cleanWin": "if exist dist rmdir /s /q dist",
    "buildWin": "npm run cleanWin && tsc",
    "start": "node dist/moviepalace-server.js",
    "dev": "ts-node src/moviepalace-server.ts",
    "dev:web": "ts-node src/webServer.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
