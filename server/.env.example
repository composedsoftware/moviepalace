# Copy this file to .env and fill in the values before starting the server.

# Required: TMDB API read-access bearer token.
# Obtain from https://www.themoviedb.org/settings/api (the "API Read Access Token").
TMDB_TOKEN=

# Port the HTTP server listens on. Defaults to 3000 when omitted.
PORT=3000

# SQLite database path, relative to the working directory where you run the server.
# The pack-prod.ps1 script copies dev.db as moviepalace.db, so use that name here.
DATABASE_URL=file:./moviepalace.db
